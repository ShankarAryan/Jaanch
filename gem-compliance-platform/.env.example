# --- Database (Supabase Postgres) ---
# DATABASE_URL = transaction-mode pooler (pgbouncer, port 6543, ?pgbouncer=true) - app runtime
# DIRECT_URL   = session-mode pooler (port 5432) - Prisma `db push` / migrations
# URL-encode special characters in the DB password (an "@" becomes %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (backstage /admin/import tool only) ---
# A team member drops the organizers' dataset files (PDF/Excel/ZIP) into the
# "dataset-uploads" bucket via the Supabase dashboard; /admin/import reads it.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Shared secret gating /admin/import (query param ?secret=... or password field).
# NOT tied to the officer/viewer/bidder session model. Any random string.
ADMIN_IMPORT_SECRET=""

# --- AI layer ---
# Used for: document field extraction (text + uploaded PDF/image -> structured
# JSON) and plain-language PO recommendations. The app runs fine with NEITHER
# key set - it falls back to deterministic output so the demo never breaks -
# but the AI features only actually run with a provider configured.
#
# Provider is picked by whichever key is present (Gemini wins if both are set):
#   GEMINI_API_KEY    - Google Gemini free tier, no credit card:
#                       https://aistudio.google.com/apikey
#                       (free tier: Google may use inputs to train - fine here,
#                        all demo bidders are synthetic. Default model is
#                        gemini-3.5-flash-lite: it has a usable free quota
#                        (~1k req/day); the full Flash models are throttled to
#                        almost nothing on the free tier.)
#   ANTHROPIC_API_KEY - Claude (needs a funded Anthropic account)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash-lite"   # default; gemini-3.6-flash if you have paid quota
ANTHROPIC_API_KEY=""

# --- Real sandbox integration: DigiLocker / API Setu ---
# The only source in this build with a genuine official government sandbox.
# Leave USE_REAL_DIGILOCKER=false to keep using the realistic mock (safe
# default for demos on unreliable venue wifi). Flip to true once you have
# partner sandbox credentials from https://sandbox.api-setu.in/
USE_REAL_DIGILOCKER="false"
DIGILOCKER_SANDBOX_BASE_URL="https://sandbox.api-setu.in"
DIGILOCKER_SANDBOX_CLIENT_ID=""
DIGILOCKER_SANDBOX_CLIENT_SECRET=""

# --- Session ---
# Signs the demo sign-in cookie (name + role) so a viewer can't edit the
# cookie to become an officer. Any random string works; set a real one for
# anything beyond a local demo. Unrelated to ADMIN_IMPORT_SECRET above.
SESSION_SECRET="change-me-to-any-random-string"
